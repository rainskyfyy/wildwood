# Godot 4+ specific ignores
.godot/
.import/

# Godot-specific ignores
android/
.android/

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/

# System/tool-specific ignores
.directory
*~

# .NET / C# build outputs (if using C# in future)
bin/
obj/
*.csproj
*.sln
*.user

# Godot export presets secrets (don't commit)
export_credentials.cfg
export_presets.cfg.user

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# OS files
*.tmp
*.bak
*.log

# CI / build artifacts
build/
dist/
out/
*.zip
!docs/**/*.zip

# Test artifacts
test_results/
coverage/
*.gcov
.gut_editor_config.json

# Lock files (Godot doesn't have package lock, but just in case)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Secrets / local config
.env
.env.local
*.secret
*.key

# GUT addon(installed by tests/scripts/install_gut.sh,见 tests/README.md)
addons/

# Node (tests/e2e 用)
tests/e2e/node_modules/
tests/e2e/screenshots/
tests/e2e/playwright-report/
tests/e2e/test-results/
tests/e2e/dist/
