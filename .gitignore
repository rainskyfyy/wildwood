# Godot 4+ specific ignores
.godot/
.import/

# Godot-specific ignores
android/
.android/

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/

# System/tool-specific ignores
.directory
*~

# .NET / C# build outputs (if using C# in future)
bin/
obj/
*.csproj
*.sln
*.user

# Godot export presets secrets (don't commit)
export_credentials.cfg
export_presets.cfg.user

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# OS files
*.tmp
*.bak
*.log

# CI / build artifacts
build/
dist/
out/
*.zip
!docs/**/*.zip

# Test artifacts
test_results/
coverage/
*.gcov
.gut_editor_config.json

# Lock files (Godot doesn't have package lock, but just in case)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Secrets / local config
.env
.env.local
*.secret
*.key

# Python (M1.4 data layer + M2.8 world/season/daynight tests)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/
